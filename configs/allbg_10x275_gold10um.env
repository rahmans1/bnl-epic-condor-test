# All backgrounds at their real rates, no physics signal, 10x275, gold-coated
# beam pipe (10 um). Sources: the campaign config_data file of k17; its proton
# beam-gas row (status 6000) becomes the merger's signal at its real rate.
SAMPLE=allbg_10x275_GoldCoating10um
SOURCES_JSON=config_data/synrad_egasbrems_egascoulomb_egastouschek_hgas_10GeVx275GeV_GoldCoating_10um_10000Ahr_machineruntime_50s.json
SIGNAL_ROW_STATUS=6000
# Events in the signal source file (proton 275GeV combined: 10M, per the Rucio file list)
SIGNAL_NEVENTS=10000000
# npsim and eicrecon, in both merger modes
CONTAINER=/cvmfs/singularity.opensciencegrid.org/eicweb/eic_xl:26.07.3-stable
# Merge step: hepmcmerger in CONTAINER unless HEPMCMERGER_CONTAINER is set;
# TimeFrameBuilder (0.9.2) is only in eic_xl 26.08.0 and later
TFB_CONTAINER=/cvmfs/singularity.opensciencegrid.org/eicweb/eic_xl:26.11.0-stable
DETECTOR_VERSION=26.07.3
DETECTOR_CONFIG=epic_craterlake
EBEAM=10
PBEAM=275
INTEGRATION_WINDOW=2000
