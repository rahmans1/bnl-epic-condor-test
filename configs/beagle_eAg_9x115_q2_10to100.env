# BeAGLE1.03.02-4.0 eAg 9x115 DIS, q2_10to100: one generator file (MODE=file), plain
# by default; -B <background config> overlays the beam backgrounds. No 9x115
# background set is in config_data/, so an overlay here borrows another
# energy's set (allowed for testing, with a warning).
MODE=file
SAMPLE=BeAGLE1.03.02-4.0_DIS_eAg_9x115_q2_10to100_ab_run001
# epic:/EVGEN/DIS/BeAGLE1.03.02-4.0/eAg/9x115/q2_10to100 in JLab Rucio, streamed
# through the anonymous OSDF door. A local path works too.
SIGNAL_FILE=root://dtn2304.jlab.org:8443//jlab-osdf-ro/eic/EPIC/cache/EVGEN/DIS/BeAGLE1.03.02-4.0/eAg/9x115/q2_10to100/BeAGLE1.03.02-4.0_DIS_eAg_9x115_q2_10to100_ab_run001.hepmc3.tree.root
# Events in SIGNAL_FILE (the Rucio file's events metadata); generator status codes
SIGNAL_NEVENTS=500000
SIGNAL_STATUS=0
EVENTS_PER_CHUNK=100
# One image for every step (merge, npsim, eicrecon): the latest eic_xl release
CONTAINER=/cvmfs/singularity.opensciencegrid.org/eicweb/eic_xl:26.11.0-stable
DETECTOR_VERSION=26.11.0
DETECTOR_CONFIG=epic_craterlake
EBEAM=9
PBEAM=115
# The ion geometry: epic_craterlake_9x115_Ag107.xml
DETECTOR_BEAMS=9x115_Ag107
