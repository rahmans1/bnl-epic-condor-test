# Particle-gun singles: 20 GeV pi+ and neutrons, cos(theta) 1-4 deg, 50k each.
# The steering is the swf-epicprod template (gun/steering.sh); 5x41 is the
# production singles geometry.
MODE=gun
GUN_PARTICLES="pi+ neutron"
GUN_ENERGY=20*GeV          # total energy, mass included (SIM.gun.energy)
GUN_THETA_MIN=1            # degrees
GUN_THETA_MAX=4            # degrees
GUN_EVENTS=50000           # per particle
EVENTS_PER_CHUNK=2000      # as production's gun config (events_per_job 2000)
CONTAINER=/cvmfs/singularity.opensciencegrid.org/eicweb/eic_xl:26.07.3-stable
DETECTOR_VERSION=26.07.3
DETECTOR_CONFIG=epic_craterlake
EBEAM=5
PBEAM=41
OVERLAY_EVENTS_PER_CHUNK=100  # overlay (-B): frames per chunk; each frame carries ~26k SR photons
